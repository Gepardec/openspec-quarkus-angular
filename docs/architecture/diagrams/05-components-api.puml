@startuml
title <size:24>Component View: Zoo-Verwaltung - REST-API</size>\n<size:24>Bausteinsicht Ebene 2: REST-API. Keine Service-Schicht, die Resources greifen direkt auf die Entity zu.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component
  .Element-RWxlbWVudCxDb21wb25lbnQ= {
    BackgroundColor: #85bbf0;
    LineColor: #5d82a8;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #000000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // REST-API
  .Boundary-UkVTVC1BUEk= {
    BackgroundColor: #ffffff;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Zoo-Verwaltung
  .Boundary-Wm9vLVZlcndhbHR1bmc= {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Zoo-Verwaltung\n<size:16>[Software System]</size>" <<Boundary-Wm9vLVZlcndhbHR1bmc=>> {
  rectangle "REST-API\n<size:16>[Container: Quarkus, Quarkus REST, Hibernate ORM Panache]</size>" <<Boundary-UkVTVC1BUEk=>> {
    rectangle "==AnimalResource\n<size:16>[Component: JAX-RS Resource]</size>\n\nCRUD für Tiere unter /api/animals. Validiert per Bean Validation, Logik direkt in der Resource." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.AnimalResource
    rectangle "==EnclosureResource\n<size:16>[Component: JAX-RS Resource]</size>\n\nGET /api/enclosures: gruppiert Tiere nach ihrem Gehege-Namen. Ein Gehege ist keine eigene Entity." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.EnclosureResource
    rectangle "==DashboardResource\n<size:16>[Component: JAX-RS Resource, MicroProfile Config]</size>\n\nGET /api/dashboard/spotlight: liefert das Tier, dessen ID in der Konfiguration steht." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.DashboardResource
    rectangle "==Animal\n<size:16>[Component: Panache Entity]</size>\n\nEinzige Entity: name, species, age, enclosure (Text), funFact. Active-Record-Zugriff." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.Animal
  }

  database "==Datenbank\n<size:16>[Container: H2]</size>\n\nIn-Memory, Schema bei jedem Start neu (drop-and-create), Startdaten aus import.sql." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as ZooVerwaltung.Datenbank
}

ZooVerwaltung.RESTAPI.AnimalResource --> ZooVerwaltung.RESTAPI.Animal <<Relationship-UmVsYXRpb25zaGlw>> : "Liest, speichert, löscht\n<size:16>[Panache]</size>"
ZooVerwaltung.RESTAPI.EnclosureResource --> ZooVerwaltung.RESTAPI.Animal <<Relationship-UmVsYXRpb25zaGlw>> : "Liest Tiere mit Gehege\n<size:16>[Panache]</size>"
ZooVerwaltung.RESTAPI.DashboardResource --> ZooVerwaltung.RESTAPI.Animal <<Relationship-UmVsYXRpb25zaGlw>> : "Liest Spotlight-Tier\n<size:16>[Panache]</size>"
ZooVerwaltung.RESTAPI.Animal --> ZooVerwaltung.Datenbank <<Relationship-UmVsYXRpb25zaGlw>> : "Tabelle animals\n<size:16>[JDBC]</size>"

@enduml
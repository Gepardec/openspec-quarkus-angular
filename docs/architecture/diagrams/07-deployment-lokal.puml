rectangle "Rechner der Teilnehmenden\n<size:16>[Deployment Node: macOS, Windows oder Linux]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as LokalWorkshop.RechnerderTeilnehmenden {
  rectangle "Browser\n<size:16>[Deployment Node: Chrome, Firefox, Edge]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as LokalWorkshop.RechnerderTeilnehmenden.Browser {
    rectangle "==Web-App\n<size:16>[Container: Angular, NgRx Signal Store, Angular Material, Transloco]</size>\n\nSingle-Page-App mit den Domänen animals, enclosures und dashboard. Sheriff erzwingt die Domänengrenzen." <<Element-RWxlbWVudCxDb250YWluZXIsV2Vi>> as LokalWorkshop.RechnerderTeilnehmenden.Browser.WebApp_1
  }

  rectangle "JVM\n<size:16>[Deployment Node: Java, Quarkus]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as LokalWorkshop.RechnerderTeilnehmenden.JVM {
    rectangle "==REST-API\n<size:16>[Container: Quarkus, Quarkus REST, Hibernate ORM Panache]</size>\n\nStellt die Fachfunktionen unter /api bereit und liefert die Web-App aus (Quinoa)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as LokalWorkshop.RechnerderTeilnehmenden.JVM.RESTAPI_1
    database "==Datenbank\n<size:16>[Container: H2]</size>\n\nIn-Memory, Schema bei jedem Start neu (drop-and-create), Startdaten aus import.sql." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as LokalWorkshop.RechnerderTeilnehmenden.JVM.Datenbank_1
  }

}

LokalWorkshop.RechnerderTeilnehmenden.Browser.WebApp_1 --> LokalWorkshop.RechnerderTeilnehmenden.JVM.RESTAPI_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Liest und ändert Daten\n<size:16>[JSON über HTTP, /api]</size>"
LokalWorkshop.RechnerderTeilnehmenden.JVM.RESTAPI_1 --> LokalWorkshop.RechnerderTeilnehmenden.JVM.Datenbank_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Liest und schreibt\n<size:16>[JDBC]</size>"

@enduml
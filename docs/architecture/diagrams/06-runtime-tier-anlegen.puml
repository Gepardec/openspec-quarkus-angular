@startuml
title <size:24>Dynamic View: Zoo-Verwaltung - Web-App</size>\n<size:24>Laufzeitsicht: Tier anlegen.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component
  .Element-RWxlbWVudCxDb21wb25lbnQ= {
    BackgroundColor: #85bbf0;
    LineColor: #5d82a8;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #000000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // REST-API
  .Boundary-UkVTVC1BUEk= {
    BackgroundColor: #ffffff;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Web-App
  .Boundary-V2ViLUFwcA== {
    BackgroundColor: #ffffff;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Zoo-Verwaltung
  .Boundary-Wm9vLVZlcndhbHR1bmc= {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Zoo-Manager:in\n<size:16>[Person]</size>\n\nPflegt Tiere, sieht Gehege und Dashboard. Der Code kennt keine Rollen und keine Anmeldung." <<Element-RWxlbWVudCxQZXJzb24=>> as ZooManagerin

rectangle "Zoo-Verwaltung\n<size:16>[Software System]</size>" <<Boundary-Wm9vLVZlcndhbHR1bmc=>> {
  rectangle "REST-API\n<size:16>[Container: Quarkus, Quarkus REST, Hibernate ORM Panache]</size>" <<Boundary-UkVTVC1BUEk=>> {
    rectangle "==AnimalResource\n<size:16>[Component: JAX-RS Resource]</size>\n\nCRUD für Tiere unter /api/animals. Validiert per Bean Validation, Logik direkt in der Resource." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.AnimalResource
    rectangle "==Animal\n<size:16>[Component: Panache Entity]</size>\n\nEinzige Entity: name, species, age, enclosure (Text), funFact. Active-Record-Zugriff." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.Animal
  }

  rectangle "Web-App\n<size:16>[Container: Angular, NgRx Signal Store, Angular Material, Transloco]</size>" <<Boundary-V2ViLUFwcA==>> {
    rectangle "==AnimalService\n<size:16>[Component: Angular Service (HttpClient), animals/data]</size>\n\nKapselt die HTTP-Aufrufe der Domäne animals." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.AnimalService
    rectangle "==Tier anlegen\n<size:16>[Component: Angular Component, animals/feature/animal-create]</size>\n\nFormular mit Validierung und Gehege-Autovervollständigung." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.Tieranlegen
    rectangle "==AnimalStore\n<size:16>[Component: NgRx Signal Store, animals/data]</size>\n\nHält Tiere, Auswahl, Gehege-Namen und Ladezustand. Navigiert nach Anlegen und Bearbeiten." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.AnimalStore
  }

  database "==Datenbank\n<size:16>[Container: H2]</size>\n\nIn-Memory, Schema bei jedem Start neu (drop-and-create), Startdaten aus import.sql." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as ZooVerwaltung.Datenbank
}

person "==Zoo-Manager:in\n<size:16>[Person]</size>\n\nPflegt Tiere, sieht Gehege und Dashboard. Der Code kennt keine Rollen und keine Anmeldung." <<Element-RWxlbWVudCxQZXJzb24=>> as ZooManagerin
database "==Datenbank\n<size:16>[Container: H2]</size>\n\nIn-Memory, Schema bei jedem Start neu (drop-and-create), Startdaten aus import.sql." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as ZooVerwaltung.Datenbank

ZooManagerin --> ZooVerwaltung.WebApp.Tieranlegen <<Relationship-UmVsYXRpb25zaGlw>> : "1: Füllt das Formular aus und speichert\n<size:16>[Browser]</size>"
ZooVerwaltung.WebApp.Tieranlegen --> ZooVerwaltung.WebApp.AnimalStore <<Relationship-UmVsYXRpb25zaGlw>> : "2: create(dto)"
ZooVerwaltung.WebApp.AnimalStore --> ZooVerwaltung.WebApp.AnimalService <<Relationship-UmVsYXRpb25zaGlw>> : "3: createAnimal(dto)\n<size:16>[RxJS]</size>"
ZooVerwaltung.WebApp.AnimalService --> ZooVerwaltung.RESTAPI.AnimalResource <<Relationship-UmVsYXRpb25zaGlw>> : "4: POST /api/animals\n<size:16>[JSON über HTTP]</size>"
ZooVerwaltung.RESTAPI.AnimalResource --> ZooVerwaltung.RESTAPI.Animal <<Relationship-UmVsYXRpb25zaGlw>> : "5: Bean Validation, persist()\n<size:16>[Panache]</size>"
ZooVerwaltung.RESTAPI.Animal --> ZooVerwaltung.Datenbank <<Relationship-UmVsYXRpb25zaGlw>> : "6: INSERT INTO animals\n<size:16>[JDBC]</size>"

@enduml
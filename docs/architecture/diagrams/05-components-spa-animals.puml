person "==Zoo-Manager:in\n<size:16>[Person]</size>\n\nPflegt Tiere, sieht Gehege und Dashboard. Der Code kennt keine Rollen und keine Anmeldung." <<Element-RWxlbWVudCxQZXJzb24=>> as ZooManagerin

rectangle "Zoo-Verwaltung\n<size:16>[Software System]</size>" <<Boundary-Wm9vLVZlcndhbHR1bmc=>> {
  rectangle "REST-API\n<size:16>[Container: Quarkus, Quarkus REST, Hibernate ORM Panache]</size>" <<Boundary-UkVTVC1BUEk=>> {
    rectangle "==AnimalResource\n<size:16>[Component: JAX-RS Resource]</size>\n\nCRUD für Tiere unter /api/animals. Validiert per Bean Validation, Logik direkt in der Resource." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.AnimalResource
    rectangle "==EnclosureResource\n<size:16>[Component: JAX-RS Resource]</size>\n\nGET /api/enclosures: gruppiert Tiere nach ihrem Gehege-Namen. Ein Gehege ist keine eigene Entity." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.RESTAPI.EnclosureResource
  }

  rectangle "Web-App\n<size:16>[Container: Angular, NgRx Signal Store, Angular Material, Transloco]</size>" <<Boundary-V2ViLUFwcA==>> {
    rectangle "==AnimalService\n<size:16>[Component: Angular Service (HttpClient), animals/data]</size>\n\nKapselt die HTTP-Aufrufe der Domäne animals." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.AnimalService
    rectangle "==withCallStatus\n<size:16>[Component: NgRx Signal Store Feature, shared/util]</size>\n\nGemeinsamer Store-Baustein für loading, loaded und error." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.withCallStatus
    rectangle "==Domäne enclosures\n<size:16>[Component: Angular, enclosures/*]</size>\n\nGehege-Übersicht mit eigenem Store und Service." <<Element-RWxlbWVudCxDb21wb25lbnQsQW5kZXJlIERvbcOkbmU=>> as ZooVerwaltung.WebApp.Domäneenclosures
    rectangle "==Domäne dashboard\n<size:16>[Component: Angular, dashboard/*]</size>\n\nDashboard mit Spotlight-Karte, eigener Store und Service." <<Element-RWxlbWVudCxDb21wb25lbnQsQW5kZXJlIERvbcOkbmU=>> as ZooVerwaltung.WebApp.Domänedashboard
    rectangle "==Tierliste\n<size:16>[Component: Angular Component, animals/feature/animal-list]</size>\n\nListet alle Tiere, Einstieg in Steckbrief und Anlegen." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.Tierliste
    rectangle "==Steckbrief\n<size:16>[Component: Angular Component, animals/feature/animal-profile]</size>\n\nZeigt ein Tier, Einstieg in Bearbeiten und Löschen." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.Steckbrief
    rectangle "==Tier anlegen\n<size:16>[Component: Angular Component, animals/feature/animal-create]</size>\n\nFormular mit Validierung und Gehege-Autovervollständigung." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.Tieranlegen
    rectangle "==Tier bearbeiten\n<size:16>[Component: Angular Component, animals/feature/animal-edit]</size>\n\nFormular zum Ändern eines Tiers." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.Tierbearbeiten
    rectangle "==Löschdialog\n<size:16>[Component: Angular Material Dialog, animals/feature/animal-delete-dialog]</size>\n\nBestätigt das Löschen eines Tiers." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.Löschdialog
    rectangle "==AnimalStore\n<size:16>[Component: NgRx Signal Store, animals/data]</size>\n\nHält Tiere, Auswahl, Gehege-Namen und Ladezustand. Navigiert nach Anlegen und Bearbeiten." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as ZooVerwaltung.WebApp.AnimalStore
  }

}

